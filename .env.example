# ====================================================================
# MediGuide AI – Environment Configuration Template
# ====================================================================

# Backend Server Configuration
SERVER_PORT=5000
PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Supabase PostgreSQL Database & Auth Configuration
# (If left empty, MediGuide AI automatically uses its resilient local store)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# External AI Service (Optional - Google Gemini or OpenAI)
# (MediGuide AI has an integrated clinical rule & educational engine that works 100% out of the box)
AI_API_KEY=
GEMINI_API_KEY=

# Maps API (Optional: Leaflet & OpenStreetMap are integrated by default with zero key required!)
MAPS_API_KEY=
